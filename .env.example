# Copy to .env and adjust. .env is git-ignored.

# Address the server listens on. Keep 127.0.0.1 unless you know why:
# event payloads can contain code and secrets from tool inputs.
AGENT_MONITOR_HOST=127.0.0.1
AGENT_MONITOR_PORT=8765

# SQLite database file.
AGENT_MONITOR_DB_PATH=./data/agent_monitor.db
